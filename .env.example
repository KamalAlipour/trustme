# PostgreSQL connection for TrustMe only
DATABASE_URL=
# Isolated Redis connection for TrustMe workers
REDIS_URL=
# Polygon RPC endpoint
POLYGON_RPC_URL=
# Deposit derivation xpub (never commit its value)
DEPOSIT_XPUB=
# Deposit wallet mnemonic path, readable by the worker at deployment time
DEPOSIT_WALLET_MNEMONIC_PATH=/etc/trustme/deposit-wallet.txt
# Must match the path used to generate DEPOSIT_XPUB; mismatch aborts worker startup by design
DEPOSIT_DERIVATION_PATH=m/44'/60'/0'/0
# Automatic deposit sweep thresholds and cadence
SWEEP_MIN_MICRO_USDT=1000000
SWEEP_MAX_GAS_TOP_UP_WEI=500000000000000000
SWEEP_SCAN_INTERVAL_MS=60000
SWEEP_BATCH_SIZE=25
SWEEP_FAILURE_BACKOFF_MS=900000
SWEEP_MAX_ATTEMPTS=5
# Hot wallet key, read only by the worker process
HOT_WALLET_PRIVATE_KEY=
# Expected Polygon network chain ID
CHAIN_ID=
# Gas safety multiplier in basis points (12500 = +25%)
GAS_SAFETY_MULTIPLIER_BPS=
# Maximum permitted transaction gas limit
GAS_LIMIT_CEILING=
# Shared API service token (never commit its value)
API_SERVICE_TOKEN=
# Set true to require email verification before member security setup can complete
REQUIRE_EMAIL_VERIFICATION=false
# Hours to block outgoing value after a PIN reset
PIN_RESET_QUARANTINE_HOURS=72
# USDT contract address on Polygon, checksummed
USDT_CONTRACT_ADDRESS=
# First block to scan for deposits
CHAIN_START_BLOCK=
# Required confirmations before ingest/settlement
CONFIRMATIONS=
# Maximum blocks per ingest request
MAX_BLOCK_RANGE=
# Maximum ingest chunks to process per worker tick
INGEST_CHUNKS_PER_TICK=
# Rewind depth after a deep reorg
REORG_REWIND_BLOCKS=
# Failover marker path. Present means this machine is not the active TrustMe node.
# API and worker refuse to start while this file exists.
FAILOVER_MARKER_PATH=/etc/trustme/FAILED_OVER
# API listen port
API_PORT=
# Admin UI API origin
TRUSTME_API_URL=
# Admin JWT signing secret, minimum 32 characters (never commit its value)
ADMIN_JWT_SECRET=
# Admin JWT lifetime in seconds
ADMIN_JWT_TTL_SECONDS=
# Hot-wallet address only; the API never reads the private key
HOT_WALLET_ADDRESS=
# JSON request body limit
API_BODY_LIMIT=
# API per-IP rate limit window in milliseconds
API_RATE_LIMIT_WINDOW_MS=
# API per-IP request limit
API_RATE_LIMIT_MAX=
# Comma-separated browser origins allowed by the API
API_ALLOWED_ORIGINS=
# Comma-separated Google OAuth client IDs accepted by the API
GOOGLE_OAUTH_CLIENT_IDS=
# Comma-separated Apple OAuth audiences accepted by the API
APPLE_OAUTH_AUDIENCES=
