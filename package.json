{
  "name": "trustme",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run prisma:generate && npm run build --workspaces",
    "lint": "eslint .",
    "typecheck": "npm run prisma:generate && npm run build -w @trustme/db && npm run build -w @trustme/core && npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "prisma:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "prisma:seed": "tsx packages/db/src/seed.ts"
  },
  "devDependencies": {
    "@types/node": "20.17.24",
    "@typescript-eslint/eslint-plugin": "8.26.0",
    "@typescript-eslint/parser": "8.26.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.1",
    "prettier": "3.5.3",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vitest": "3.0.8"
  }
}
