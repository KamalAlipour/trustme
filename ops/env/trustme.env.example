# TrustMe production environment. Replace every empty placeholder through the
# secret-management process before enabling any service. Never commit this file
# after filling it with secrets.
DATABASE_URL=
REDIS_URL=
POLYGON_RPC_URL=
DEPOSIT_XPUB=
DEPOSIT_WALLET_MNEMONIC_PATH=/etc/trustme/deposit-wallet.txt
# Must match the path used to generate DEPOSIT_XPUB; mismatch aborts worker startup by design
DEPOSIT_DERIVATION_PATH=m/44'/60'/0'/0
SWEEP_MIN_MICRO_USDT=1000000
SWEEP_MAX_GAS_TOP_UP_WEI=500000000000000000
SWEEP_SCAN_INTERVAL_MS=60000
SWEEP_BATCH_SIZE=25
SWEEP_FAILURE_BACKOFF_MS=900000
SWEEP_MAX_ATTEMPTS=5
HOT_WALLET_PRIVATE_KEY=
HOT_WALLET_ADDRESS=
API_SERVICE_TOKEN=
ADMIN_JWT_SECRET=
ADMIN_JWT_TTL_SECONDS=3600
MEMBER_JWT_SECRET=
MEMBER_JWT_TTL_SECONDS=900
MEMBER_REFRESH_TTL_DAYS=60
EMAIL_DELIVERY=none
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
USDT_CONTRACT_ADDRESS=
CHAIN_ID=137
GAS_SAFETY_MULTIPLIER_BPS=12500
GAS_LIMIT_CEILING=200000
TRUSTME_API_URL=
API_BIND_HOST=127.0.0.1
API_PORT=3121
TRUSTME_ADMIN_PORT=3122
API_BODY_LIMIT=32kb
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=60
# Comma-separated browser origins allowed by the API, for example:
# API_ALLOWED_ORIGINS=https://app-trustcoupon.komasi.as
API_ALLOWED_ORIGINS=
CHAIN_START_BLOCK=0
CONFIRMATIONS=12
MAX_BLOCK_RANGE=2000
INGEST_CHUNKS_PER_TICK=20
REORG_REWIND_BLOCKS=64
CHAIN_MAX_BLOCK_AGE_SECONDS=120
# Present means this machine is not active. API and worker refuse to start.
FAILOVER_MARKER_PATH=/etc/trustme/FAILED_OVER
MEDIA_STORAGE_DIR=/var/lib/trustme/media

# Hostnames; do not use FairFare hostnames.
TRUSTME_API_HOST=
TRUSTME_ADMIN_HOST=

# Isolated PostgreSQL cluster and credentials.
TRUSTME_PG_VERSION=
TRUSTME_PG_PORT=5434
TRUSTME_PG_DATABASE=trustme
TRUSTME_PG_ROLE=trustme
TRUSTME_PG_PASSWORD=
TRUSTME_PGPASS_FILE=/etc/trustme/pgpass

# Isolated Redis instance.
TRUSTME_REDIS_PORT=6380
TRUSTME_REDIS_PASSWORD=
TRUSTME_REDIS_DATA_DIR=/var/lib/trustme-redis

# Server 1 / Server 2 replication and fencing values.
TRUSTME_PRIMARY_HOST=
TRUSTME_STANDBY_HOST=
TRUSTME_SSH_USER=
TRUSTME_SSH_KEY=
TRUSTME_REPLICATION_ROLE=
TRUSTME_REPLICATION_PASSWORD=
TRUSTME_REPLICATION_SLOT=
TRUSTME_REPLICATION_TUNNEL_PORT=5435
TRUSTME_FAILBACK_TUNNEL_PORT=5436
TRUSTME_REPOSITORY_URL=
TRUSTME_REPO_CACHE=/opt/trustme/repository.git
TRUSTME_RELEASE_ROOT=/opt/trustme/releases
TRUSTME_CURRENT_LINK=/opt/trustme/current
TRUSTME_SHARED_ROOT=/opt/trustme/shared
TRUSTME_DEPLOY_PATH=/opt/trustme/ops
TRUSTME_NGINX_VHOST=/etc/nginx/sites-available/trustme.conf
