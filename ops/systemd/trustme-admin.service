[Unit]
Description=TrustMe admin UI
After=network-online.target trustme-api.service
Wants=network-online.target

[Service]
Type=simple
User=trustme-admin
Group=trustme
WorkingDirectory=/opt/trustme/current/apps/admin
# Admin only needs non-secret settings; never load trustme.env here.
EnvironmentFile=/etc/trustme/admin.env
Environment=NODE_ENV=production
ExecStartPre=/bin/sh -c 'test ! -e "$${FAILOVER_MARKER_PATH:-/etc/trustme/FAILED_OVER}"'
ExecStart=/usr/bin/node /opt/trustme/current/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3122
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
InaccessiblePaths=/etc/trustme /opt/trustme/shared
UMask=0077

[Install]
WantedBy=multi-user.target
