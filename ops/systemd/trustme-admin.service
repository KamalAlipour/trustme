[Unit]
Description=TrustMe admin UI
After=network-online.target trustme-api.service
Wants=network-online.target

[Service]
Type=simple
User=trustme
Group=trustme
WorkingDirectory=/opt/trustme/current/apps/admin
EnvironmentFile=/etc/trustme/trustme.env
UnsetEnvironment=DATABASE_URL REDIS_URL POLYGON_RPC_URL DEPOSIT_XPUB \
  HOT_WALLET_PRIVATE_KEY HOT_WALLET_ADDRESS API_SERVICE_TOKEN ADMIN_JWT_SECRET \
  ADMIN_JWT_TTL_SECONDS USDT_CONTRACT_ADDRESS CHAIN_ID GAS_SAFETY_MULTIPLIER_BPS \
  GAS_LIMIT_CEILING API_PORT API_BODY_LIMIT API_RATE_LIMIT_WINDOW_MS \
  API_RATE_LIMIT_MAX CHAIN_START_BLOCK CONFIRMATIONS MAX_BLOCK_RANGE \
  REORG_REWIND_BLOCKS TRUSTME_API_HOST TRUSTME_PG_VERSION TRUSTME_PG_PORT \
  TRUSTME_PG_DATABASE TRUSTME_PG_ROLE TRUSTME_PG_PASSWORD TRUSTME_REDIS_PORT \
  TRUSTME_REDIS_PASSWORD TRUSTME_REDIS_DATA_DIR TRUSTME_PRIMARY_HOST \
  TRUSTME_STANDBY_HOST TRUSTME_SSH_USER TRUSTME_SSH_KEY \
  TRUSTME_REPLICATION_ROLE TRUSTME_REPLICATION_PASSWORD \
  TRUSTME_REPLICATION_SLOT TRUSTME_REPLICATION_TUNNEL_PORT \
  TRUSTME_FAILBACK_TUNNEL_PORT TRUSTME_REPOSITORY_URL TRUSTME_REPO_CACHE \
  TRUSTME_RELEASE_ROOT TRUSTME_CURRENT_LINK TRUSTME_SHARED_ROOT \
  TRUSTME_DEPLOY_PATH TRUSTME_NGINX_VHOST
ExecStartPre=/bin/sh -c 'test ! -e "$${FAILOVER_MARKER_PATH:-/etc/trustme/FAILED_OVER}"'
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3122
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trustme/shared
UMask=0077

[Install]
WantedBy=multi-user.target
