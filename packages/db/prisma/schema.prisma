generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Asset {
  USDT
  COUPON
}

enum AccountType {
  USER_COUPON
  CHARITY_COUPON
  ESCROW
  GUARANTEE_LOCK
  SYSTEM_COUPON_ISSUANCE
  SYSTEM_DEMO_ISSUANCE
  SYSTEM_VAULT_USDT
  SYSTEM_WITHDRAWAL_PENDING
  SYSTEM_FEE_COLLECTION
  EXTERNAL_ONCHAIN
}

enum TransactionType {
  DEPOSIT
  TRANSFER
  ESCROW_HOLD
  ESCROW_RELEASE
  ESCROW_CANCEL
  WITHDRAWAL
  REFUND
  FEE
  GUARANTEE_LOCK
  GUARANTEE_RELEASE
  GUARANTEE_CLAIM
  LOAN_DISBURSE
  LOAN_REPAY
  DEMO_ISSUE
}

enum LoanStatus {
  REQUESTED
  ACTIVE
  SETTLED
  DEFAULTED
  CANCELLED
}

enum GuaranteeStatus {
  PENDING
  CONFIRMATION_PENDING
  CODE_LOCKED
  ACTIVE
  RELEASED
  CLAIMED
  DECLINED
  CANCELLED
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  REJECTED
  APPROVED
  PENDING_APPROVAL
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum EscrowStatus {
  ACTIVE
  RELEASED
  CANCELLED
  EXPIRED
  LOCKED
}

enum WithdrawalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum DepositSweepStatus {
  PENDING
  GAS_FUNDING
  BROADCAST
  CONFIRMED
  FAILED
}

enum AdminRole {
  VIEWER
  APPROVER
  ADMIN
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum IdentityVerificationStatus {
  UNVERIFIED
  VERIFIED
  MISMATCH
  INCONCLUSIVE
}

enum BalanceDisclosureStatus {
  PENDING
  CONSUMED
  DENIED
  EXPIRED
}

enum IdentityReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IdentityCaptureStep {
  DOCUMENT_FRONT
  SELFIE_NEUTRAL
  SELFIE_TURNED
  SELFIE_WITH_DOCUMENT
}

enum EmailVerificationPurpose {
  VERIFY_EMAIL
  PIN_RESET
}

enum MediaKind {
  AUDIO
  IMAGE
  VIDEO
  DOCUMENT
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CharityAgentRole {
  AGENT
  MANAGER
}

enum AidRequestStatus {
  PENDING
  DOCUMENTS_REQUESTED
  APPROVED
  GUARANTEED
  REJECTED
}

enum PurchaseGuaranteeStatus {
  ACTIVE
  EXHAUSTED
  REVOKED
}

enum CommissionDisputeStatus {
  OPEN
  RESOLVED_BY_MARKETER
  AUTO_RESOLVED
}

enum CommissionPayoutRole {
  BUYER_MARKETER
  SELLER_MARKETER
  TRAINER
}

enum IdentityProvider {
  GOOGLE
  APPLE
}

enum MemberWalletKind {
  EXTERNAL
  IN_APP
  SMART_ACCOUNT
}

enum EscrowEventKind {
  DEPOSIT
  SETTLE
  UNLOAD
}

enum PayCodeStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum EscrowSettlementStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum EscrowUnloadStatus {
  PENDING
  CONFIRMED
  FAILED
}

model User {
  id                   String              @id @default(uuid()) @db.Uuid
  phoneNumber          String?             @unique
  barcodeId            String              @unique
  aliasName            String?
  displayName          String?
  country              String?
  kycStatus            KycStatus           @default(UNVERIFIED)
  identityVerificationStatus IdentityVerificationStatus @default(UNVERIFIED)
  identityVerifiedAt   DateTime?
  nationalIdHash       String?
  ibanNumber           String?
  ibanVerifiedAt       DateTime?
  identityCheckCount   Int                 @default(0)
  lastIdentityCheckAt  DateTime?
  email                String?             @unique
  emailVerifiedAt      DateTime?
  pinHash              String?
  pinUpdatedAt         DateTime?
  pinAttempts          Int                 @default(0)
  pinLockCount         Int                 @default(0)
  pinLockedUntil       DateTime?
  securitySetupCompletedAt DateTime?
  biometricEnrolledAt  DateTime?
  setupAcknowledgedAt DateTime?
  pinResetQuarantineUntil DateTime?
  isDemo               Boolean             @default(false)
  commissionRateBps    Int                 @default(0)
  marketerId           String?             @db.Uuid
  trainerId            String?             @db.Uuid
  dustMicroUsdt        BigInt              @default(0)
  activeGuaranteeCount Int                 @default(0)
  createdAt            DateTime            @default(now())
  depositAddresses     DepositAddress[]
  ledgerAccounts       LedgerAccount[]
  transactions         Transaction[]
  escrowHolds          EscrowHold[]        @relation("EscrowSender")
  receivedEscrows      EscrowHold[]        @relation("EscrowRecipient")
  withdrawals          Withdrawal[]
  borrowerLoans        Loan[]              @relation("LoanBorrower")
  lenderLoans          Loan[]              @relation("LoanLender")
  requestedLenderLoans Loan[]              @relation("LoanRequestedLender")
  guarantees           Guarantee[]
  contacts             Contact[]           @relation("ContactOwner")
  contactedBy          Contact[]           @relation("ContactTarget")
  devices              MemberDevice[]
  emailCodes           EmailVerification[]
  charityAgents        CharityAgent[]
  aidRequests          AidRequest[]        @relation("AidApplicant")
  decidedAidRequests   AidRequest[]        @relation("AidDecider")
  mediaAssets          MediaAsset[]
  buyerRefunds         RefundRequest[]     @relation("RefundBuyer")
  sellerRefunds        RefundRequest[]     @relation("RefundSeller")
  identities           UserIdentity[]
  identityChecks       IdentityCheck[]
  bankAccountChecks    BankAccountCheck[]
  identityReviews      IdentityReview[]
  identityCaptureSessions IdentityCaptureSession[]
  balanceDisclosureRequests BalanceDisclosureRequest[]
  wallets              MemberWallet[]
  escrowBalance        EscrowBalance?
  payCodes             PayCode[]          @relation("PayCodeBuyer")
  payCodesToCollect    PayCode[]          @relation("PayCodeMerchant")
  buyerSettlements     EscrowSettlement[] @relation("EscrowSettlementBuyer")
  merchantSettlements  EscrowSettlement[] @relation("EscrowSettlementMerchant")
  payerSettlements      EscrowSettlement[] @relation("EscrowSettlementPayer")
  purchaseGuaranteesAsGuarantor PurchaseGuarantee[] @relation("PurchaseGuarantor")
  purchaseGuaranteesAsBeneficiary PurchaseGuarantee[] @relation("PurchaseGuaranteeBeneficiary")
  marketer             User?              @relation("Marketer", fields: [marketerId], references: [id])
  referredMembers      User[]             @relation("Marketer")
  trainer              User?              @relation("Trainer", fields: [trainerId], references: [id])
  trainees             User[]             @relation("Trainer")
  commissionDisputesAsSeller CommissionDispute[] @relation("CommissionDisputeSeller")
  commissionDisputesAsMarketer CommissionDispute[] @relation("CommissionDisputeMarketer")
  commissionPayoutsReceived CommissionPayout[] @relation("PayoutRecipient")
  commissionPayoutsAttributed CommissionPayout[] @relation("PayoutSource")
  unloads              EscrowUnload[]
  escrowChainEvents    EscrowChainEvent[]

  @@index([pinResetQuarantineUntil])
  @@index([isDemo])
}

model IdentityCheck {
  id            String                     @id @default(uuid()) @db.Uuid
  userId        String                     @db.Uuid
  provider      String                     @default("SHAHKAR")
  status        IdentityVerificationStatus
  providerCode  Int?
  nationalIdHash String
  mobileHash    String
  createdAt     DateTime                   @default(now())
  user          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BankAccountCheck {
  id             String                     @id @default(uuid()) @db.Uuid
  userId         String                     @db.Uuid
  provider       String                     @default("IBAN_MATCH")
  status         IdentityVerificationStatus
  providerCode   Int?
  ibanHash       String
  nationalIdHash String
  createdAt      DateTime                   @default(now())
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model BalanceDisclosureRequest {
  id         String                  @id @default(uuid()) @db.Uuid
  userId     String                  @db.Uuid
  code       String?
  status     BalanceDisclosureStatus @default(PENDING)
  attempts   Int                     @default(0)
  expiresAt  DateTime
  createdAt  DateTime                @default(now())
  resolvedAt DateTime?
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, expiresAt])
}

model IdentityReview {
  id               String               @id @default(uuid()) @db.Uuid
  userId           String               @db.Uuid
  country          String
  status           IdentityReviewStatus @default(PENDING)
  documentAssetId  String?              @unique @db.Uuid
  selfieAssetId    String?              @unique @db.Uuid
  captureSessionId String?              @unique @db.Uuid
  challengeCode    String?
  documentFrontCapturedAt DateTime?
  selfieNeutralCapturedAt DateTime?
  selfieTurnedCapturedAt DateTime?
  selfieWithDocumentCapturedAt DateTime?
  decisionNote     String?
  decidedByAdminId String?              @db.Uuid
  decidedAt        DateTime?
  createdAt        DateTime              @default(now())
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentAsset    MediaAsset?          @relation("IdentityReviewDocument", fields: [documentAssetId], references: [id], onDelete: SetNull)
  selfieAsset      MediaAsset?          @relation("IdentityReviewSelfie", fields: [selfieAssetId], references: [id], onDelete: SetNull)
  captureSession   IdentityCaptureSession? @relation(fields: [captureSessionId], references: [id], onDelete: SetNull)
  decidedByAdmin   AdminUser?           @relation("IdentityReviewDecider", fields: [decidedByAdminId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
}

model IdentityCaptureSession {
  id            String               @id @default(uuid()) @db.Uuid
  userId        String               @db.Uuid
  challengeCode String
  steps         IdentityCaptureStep[]
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime              @default(now())
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaAssets   MediaAsset[]
  review        IdentityReview?

  @@index([userId, createdAt])
  @@index([expiresAt, consumedAt])
}
model UserIdentity {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  provider  IdentityProvider
  subject   String
  email     String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

model MemberDevice {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  installationId   String?
  label            String
  refreshTokenHash String    @unique
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?   @unique @db.Uuid
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@index([userId, installationId])
}

model EmailVerification {
  id         String                   @id @default(uuid()) @db.Uuid
  userId     String                   @db.Uuid
  email      String
  codeHash   String
  purpose    EmailVerificationPurpose
  attempts   Int                      @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime                 @default(now())
  user       User                     @relation(fields: [userId], references: [id])

  @@index([userId, purpose, createdAt])
}

model Contact {
  id             String    @id @default(uuid()) @db.Uuid
  ownerId        String    @db.Uuid
  contactUserId  String    @db.Uuid
  alias          String
  createdAt      DateTime  @default(now())
  lastActivityAt DateTime?
  owner          User      @relation("ContactOwner", fields: [ownerId], references: [id])
  contactUser    User      @relation("ContactTarget", fields: [contactUserId], references: [id])

  @@unique([ownerId, contactUserId])
  @@index([ownerId, alias])
}

model DepositAddress {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  derivationIndex Int            @unique @default(autoincrement())
  address         String         @unique
  createdAt       DateTime       @default(now())
  sweepPendingAt  DateTime?
  user            User           @relation(fields: [userId], references: [id])
  sweeps          DepositSweep[]

  @@index([sweepPendingAt])
}

model DepositSweep {
  id               String            @id @default(uuid()) @db.Uuid
  depositAddressId String            @db.Uuid
  amountMicroUsdt  BigInt
  gasTxHash        String?
  sweepTxHash      String?           @unique
  status           DepositSweepStatus @default(PENDING)
  attempts         Int               @default(0)
  lastError        String?
  createdAt        DateTime          @default(now())
  confirmedAt      DateTime?
  depositAddress   DepositAddress    @relation(fields: [depositAddressId], references: [id])

  @@index([depositAddressId])
}

model LedgerAccount {
  id          String        @id @default(uuid()) @db.Uuid
  type        AccountType
  asset       Asset
  userId      String?       @db.Uuid
  charityId   String?       @db.Uuid
  balance     BigInt        @default(0)
  createdAt   DateTime      @default(now())
  user        User?         @relation(fields: [userId], references: [id])
  charity     Charity?      @relation(fields: [charityId], references: [id])
  outgoing    LedgerEntry[] @relation("LedgerFrom")
  incoming    LedgerEntry[] @relation("LedgerTo")
  escrowHolds EscrowHold[]

  @@unique([type, userId, asset])
  @@unique([type, charityId, asset])
  @@index([type, asset])
}

model LedgerEntry {
  id            String        @id @default(uuid()) @db.Uuid
  transactionId String        @db.Uuid
  fromAccountId String        @db.Uuid
  toAccountId   String        @db.Uuid
  amount        BigInt
  asset         Asset
  createdAt     DateTime      @default(now())
  transaction   Transaction   @relation(fields: [transactionId], references: [id])
  fromAccount   LedgerAccount @relation("LedgerFrom", fields: [fromAccountId], references: [id])
  toAccount     LedgerAccount @relation("LedgerTo", fields: [toAccountId], references: [id])

  @@index([transactionId])
}

model Transaction {
  id                    String            @id @default(uuid()) @db.Uuid
  userId                String?           @db.Uuid
  type                  TransactionType
  status                TransactionStatus @default(PENDING)
  amountMicroUsdt       BigInt            @default(0)
  amountCoupons         BigInt            @default(0)
  feeMicroUsdt          BigInt            @default(0)
  roundingDustMicroUsdt BigInt            @default(0)
  txHash                String?
  externalRef           String            @unique
  createdAt             DateTime          @default(now())
  user                  User?             @relation(fields: [userId], references: [id])
  entries               LedgerEntry[]
  escrowHold            EscrowHold?       @relation("EscrowRelease")
  escrowHoldTransaction EscrowHold?       @relation("EscrowHoldTransaction")
  withdrawal            Withdrawal?
  loanDisbursement      Loan?             @relation("LoanDisbursement")
  guaranteeLock         Guarantee?        @relation("GuaranteeLockTransaction")
  originalRefunds       RefundRequest[]   @relation("OriginalRefundTransaction")
  refundRequest         RefundRequest?    @relation("RefundTransaction")
  aidDisbursement       AidRequest?       @relation("AidDisbursementTransaction")
  escrowSettlement      EscrowSettlement?
  commissionPayouts     CommissionPayout[]

  @@index([userId, createdAt])
}

model MemberWallet {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  address    String           @unique
  kind       MemberWalletKind
  chainId    Int
  isPrimary  Boolean          @default(true)
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id])

  @@index([userId])
}

model EscrowBalance {
  userId            String   @id @db.Uuid
  lockedMicroUsdt   BigInt   @default(0)
  reservedMicroUsdt BigInt   @default(0)
  lastEventAt       DateTime?
  user              User     @relation(fields: [userId], references: [id])
}

model EscrowChainEvent {
  id              String          @id @default(uuid()) @db.Uuid
  kind            EscrowEventKind
  txHash          String
  logIndex        Int
  blockNumber     BigInt
  walletAddress   String
  amountMicroUsdt BigInt
  ref             String?
  userId          String?         @db.Uuid
  reconciledAt    DateTime?
  createdAt       DateTime        @default(now())
  user            User?           @relation(fields: [userId], references: [id])

  @@unique([txHash, logIndex])
  @@index([walletAddress])
}

model PayCode {
  id                 String        @id @default(uuid()) @db.Uuid
  buyerId            String        @db.Uuid
  merchantId         String?       @db.Uuid
  codeHash           String
  amountMicroUsdt    BigInt?
  maxAmountMicroUsdt BigInt
  guaranteeId        String?       @db.Uuid
  expiresAt          DateTime
  status             PayCodeStatus @default(ACTIVE)
  wrongAttempts      Int           @default(0)
  createdAt          DateTime      @default(now())
  usedAt             DateTime?
  buyer              User          @relation("PayCodeBuyer", fields: [buyerId], references: [id])
  merchant           User?         @relation("PayCodeMerchant", fields: [merchantId], references: [id])
  guarantee          PurchaseGuarantee? @relation(fields: [guaranteeId], references: [id])

  @@index([buyerId, status])
  @@index([expiresAt, status])
  @@index([merchantId, status, expiresAt])
}

model EscrowSettlement {
  id              String                 @id @default(uuid()) @db.Uuid
  buyerId         String                 @db.Uuid
  payerId         String                 @db.Uuid
  merchantId      String                 @db.Uuid
  payCodeId       String                 @unique @db.Uuid
  guaranteeId     String?                @db.Uuid
  amountMicroUsdt BigInt
  ref             String                 @unique
  externalRef     String?                @unique
  status          EscrowSettlementStatus @default(PENDING)
  transactionId   String?                @unique @db.Uuid
  chainTxHash     String?
  lastError       String?
  attempts        Int                    @default(0)
  createdAt       DateTime               @default(now())
  confirmedAt     DateTime?
  buyer           User                   @relation("EscrowSettlementBuyer", fields: [buyerId], references: [id])
  payer           User                   @relation("EscrowSettlementPayer", fields: [payerId], references: [id])
  merchant        User                   @relation("EscrowSettlementMerchant", fields: [merchantId], references: [id])
  guarantee       PurchaseGuarantee?     @relation(fields: [guaranteeId], references: [id])
  transaction     Transaction?           @relation(fields: [transactionId], references: [id])
}

model EscrowUnload {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @db.Uuid
  walletAddress   String
  amountMicroUsdt BigInt
  ref             String             @unique
  status          EscrowUnloadStatus @default(PENDING)
  chainTxHash     String?
  lastError       String?
  attempts        Int                @default(0)
  createdAt       DateTime           @default(now())
  confirmedAt     DateTime?
  user            User               @relation(fields: [userId], references: [id])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model CommissionDispute {
  id             String                  @id @default(uuid()) @db.Uuid
  sellerId       String                  @db.Uuid
  marketerId     String                  @db.Uuid
  strikes        Int                     @default(1)
  lastStrikeAt   DateTime
  openedRateBps  Int
  status         CommissionDisputeStatus @default(OPEN)
  resolvedRateBps Int?
  resolvedAt     DateTime?
  createdAt      DateTime                @default(now())
  seller         User                    @relation("CommissionDisputeSeller", fields: [sellerId], references: [id])
  marketer       User                    @relation("CommissionDisputeMarketer", fields: [marketerId], references: [id])

  @@index([sellerId, status])
}

model CommissionPayout {
  id            String               @id @default(uuid()) @db.Uuid
  transactionId String               @db.Uuid
  recipientId   String               @db.Uuid
  sourceUserId  String               @db.Uuid
  role          CommissionPayoutRole
  amount        BigInt
  createdAt     DateTime             @default(now())
  transaction   Transaction          @relation(fields: [transactionId], references: [id])
  recipient     User                 @relation("PayoutRecipient", fields: [recipientId], references: [id])
  sourceUser    User                 @relation("PayoutSource", fields: [sourceUserId], references: [id])

  @@index([recipientId, role])
  @@index([transactionId])
}

model EscrowHold {
  id                   String        @id @default(uuid()) @db.Uuid
  senderId             String        @db.Uuid
  recipientId          String        @db.Uuid
  escrowAccountId      String        @db.Uuid
  transactionId        String        @unique @db.Uuid
  releaseTransactionId String?       @unique @db.Uuid
  amountCoupons        BigInt
  codeHash             String
  wrongAttempts        Int           @default(0)
  expiresAt            DateTime
  status               EscrowStatus  @default(ACTIVE)
  createdAt            DateTime      @default(now())
  sender               User          @relation("EscrowSender", fields: [senderId], references: [id])
  recipient            User          @relation("EscrowRecipient", fields: [recipientId], references: [id])
  escrowAccount        LedgerAccount @relation(fields: [escrowAccountId], references: [id])
  transaction          Transaction   @relation("EscrowHoldTransaction", fields: [transactionId], references: [id])
  releaseTransaction   Transaction?  @relation("EscrowRelease", fields: [releaseTransactionId], references: [id])

  @@index([senderId, status])
  @@index([expiresAt, status])
}

model Withdrawal {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @db.Uuid
  transactionId      String           @unique @db.Uuid
  destinationAddress String
  couponsGross       BigInt
  grossMicroUsdt     BigInt
  feeMicroUsdt       BigInt
  netMicroUsdt       BigInt
  status             WithdrawalStatus @default(PENDING_APPROVAL)
  chainTxHash        String?
  broadcastedAt      DateTime?
  eligibleAt         DateTime
  createdAt          DateTime         @default(now())
  user               User             @relation(fields: [userId], references: [id])
  transaction        Transaction      @relation(fields: [transactionId], references: [id])

  @@index([status, createdAt])
}

model Loan {
  id                        String            @id @default(uuid()) @db.Uuid
  borrowerId                String            @db.Uuid
  lenderId                  String?           @db.Uuid
  requestedLenderId         String?           @db.Uuid
  principalCoupons          BigInt
  outstandingCoupons        BigInt            @default(0)
  description               String?
  status                    LoanStatus        @default(REQUESTED)
  createdAt                 DateTime          @default(now())
  fundedAt                  DateTime?
  settledAt                 DateTime?
  borrower                  User              @relation("LoanBorrower", fields: [borrowerId], references: [id])
  lender                    User?             @relation("LoanLender", fields: [lenderId], references: [id])
  requestedLender           User?             @relation("LoanRequestedLender", fields: [requestedLenderId], references: [id])
  installments              LoanInstallment[]
  guarantees                Guarantee[]
  aidRequests               AidRequest[]
  media                     MediaAsset[]
  disbursement              Transaction?      @relation("LoanDisbursement", fields: [disbursementTransactionId], references: [id])
  disbursementTransactionId String?           @unique @db.Uuid

  @@index([borrowerId, status])
  @@index([lenderId, status])
  @@index([requestedLenderId, status])
}

model LoanInstallment {
  id            String    @id @default(uuid()) @db.Uuid
  loanId        String    @db.Uuid
  sequence      Int
  dueAt         DateTime
  amountCoupons BigInt
  paidCoupons   BigInt    @default(0)
  paidAt        DateTime?
  loan          Loan      @relation(fields: [loanId], references: [id])

  @@unique([loanId, sequence])
  @@index([loanId, dueAt])
}

model Guarantee {
  id                String          @id @default(uuid()) @db.Uuid
  loanId            String          @db.Uuid
  guarantorId       String          @db.Uuid
  amountCoupons     BigInt
  codeHash          String?
  wrongAttempts     Int             @default(0)
  status            GuaranteeStatus @default(PENDING)
  lockTransactionId String?         @unique @db.Uuid
  createdAt         DateTime        @default(now())
  lockedAt          DateTime?
  activatedAt       DateTime?
  resolvedAt        DateTime?
  loan              Loan            @relation(fields: [loanId], references: [id])
  guarantor         User            @relation(fields: [guarantorId], references: [id])
  lockTransaction   Transaction?    @relation("GuaranteeLockTransaction", fields: [lockTransactionId], references: [id])

  @@unique([loanId, guarantorId])
  @@index([guarantorId, status])
}

model MediaAsset {
  id              String         @id @default(uuid()) @db.Uuid
  ownerId         String         @db.Uuid
  kind            MediaKind
  mimeType        String
  byteSize        Int
  sha256          String
  storageKey      String         @unique
  refundRequestId String?        @db.Uuid
  aidRequestId    String?        @db.Uuid
  loanId          String?        @db.Uuid
  captureSessionId String?        @db.Uuid
  captureStep     IdentityCaptureStep?
  createdAt       DateTime       @default(now())
  owner           User           @relation(fields: [ownerId], references: [id])
  refundRequest   RefundRequest? @relation(fields: [refundRequestId], references: [id])
  aidRequest      AidRequest?    @relation(fields: [aidRequestId], references: [id])
  loan            Loan?          @relation(fields: [loanId], references: [id])
  captureSession  IdentityCaptureSession? @relation(fields: [captureSessionId], references: [id], onDelete: SetNull)
  identityReviewDocuments IdentityReview[] @relation("IdentityReviewDocument")
  identityReviewSelfies   IdentityReview[] @relation("IdentityReviewSelfie")

  @@index([ownerId, createdAt])
  @@index([refundRequestId])
  @@index([aidRequestId])
  @@index([loanId])
  @@index([captureSessionId, captureStep])
  @@unique([captureSessionId, captureStep])
}

model RefundRequest {
  id                  String       @id @default(uuid()) @db.Uuid
  transactionId       String       @db.Uuid
  buyerId             String       @db.Uuid
  sellerId            String       @db.Uuid
  amountCoupons       BigInt
  reason              String
  status              RefundStatus @default(PENDING)
  decisionNote        String?
  refundTransactionId String?      @unique @db.Uuid
  createdAt           DateTime     @default(now())
  decidedAt           DateTime?
  transaction         Transaction  @relation("OriginalRefundTransaction", fields: [transactionId], references: [id])
  buyer               User         @relation("RefundBuyer", fields: [buyerId], references: [id])
  seller              User         @relation("RefundSeller", fields: [sellerId], references: [id])
  refundTransaction   Transaction? @relation("RefundTransaction", fields: [refundTransactionId], references: [id])
  media               MediaAsset[]

  @@index([sellerId, status, createdAt])
  @@index([buyerId, createdAt])
}

model Charity {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @unique
  description    String?
  contactEmail   String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  agents         CharityAgent[]
  aidRequests    AidRequest[]
  ledgerAccounts LedgerAccount[]
  purchaseGuarantees PurchaseGuarantee[]
}

model PurchaseGuarantee {
  id                 String                 @id @default(uuid()) @db.Uuid
  charityId          String                 @db.Uuid
  guarantorId        String                 @db.Uuid
  beneficiaryId      String                 @db.Uuid
  aidRequestId       String?                @unique @db.Uuid
  amountMicroUsdt    BigInt
  remainingMicroUsdt BigInt
  status             PurchaseGuaranteeStatus @default(ACTIVE)
  note               String?
  createdAt          DateTime               @default(now())
  closedAt           DateTime?
  charity            Charity                @relation(fields: [charityId], references: [id])
  guarantor          User                   @relation("PurchaseGuarantor", fields: [guarantorId], references: [id])
  beneficiary        User                   @relation("PurchaseGuaranteeBeneficiary", fields: [beneficiaryId], references: [id])
  aidRequest         AidRequest?            @relation(fields: [aidRequestId], references: [id])
  settlements        EscrowSettlement[]
  payCodes           PayCode[]

  @@index([beneficiaryId, status])
  @@index([guarantorId, status])
}

model CharityAgent {
  id        String           @id @default(uuid()) @db.Uuid
  charityId String           @db.Uuid
  userId    String           @db.Uuid
  role      CharityAgentRole @default(AGENT)
  revokedAt DateTime?
  createdAt DateTime         @default(now())
  charity   Charity          @relation(fields: [charityId], references: [id])
  user      User             @relation(fields: [userId], references: [id])

  @@unique([charityId, userId])
  @@index([userId, revokedAt])
}

model AidRequest {
  id                        String           @id @default(uuid()) @db.Uuid
  charityId                 String           @db.Uuid
  applicantId               String           @db.Uuid
  loanId                    String?          @db.Uuid
  amountCoupons             BigInt
  approvedCoupons           BigInt?
  description               String
  status                    AidRequestStatus @default(PENDING)
  decisionNote              String?
  decidedById               String?          @db.Uuid
  disbursementTransactionId String?          @unique @db.Uuid
  createdAt                 DateTime         @default(now())
  decidedAt                 DateTime?
  charity                   Charity          @relation(fields: [charityId], references: [id])
  applicant                 User             @relation("AidApplicant", fields: [applicantId], references: [id])
  loan                      Loan?            @relation(fields: [loanId], references: [id])
  decidedBy                 User?            @relation("AidDecider", fields: [decidedById], references: [id])
  disbursementTransaction   Transaction?     @relation("AidDisbursementTransaction", fields: [disbursementTransactionId], references: [id])
  guarantee                 PurchaseGuarantee?
  media                     MediaAsset[]

  @@index([charityId, status, createdAt])
  @@index([applicantId, createdAt])
}

model ChainCursor {
  id            Int      @id @default(1)
  nextBlock     BigInt
  lastBlockHash String?
  updatedAt     DateTime @updatedAt
}

model AdminUser {
  id           String          @id @default(uuid()) @db.Uuid
  username     String          @unique
  passwordHash String
  role         AdminRole
  createdAt    DateTime        @default(now())
  auditLogs    AdminAuditLog[]
  identityReviews IdentityReview[] @relation("IdentityReviewDecider")
}

model AdminAuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @db.Uuid
  action      String
  entityType  String
  entityId    String
  oldValue    String?
  newValue    String?
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([entityType, entityId])
}
