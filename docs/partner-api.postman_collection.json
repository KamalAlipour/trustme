{
  "info": {
    "name": "TrustMe Partner API",
    "_postman_id": "trustme-partner-api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "apiKey", "value": "tck_replace"},
    {"key": "apiSecret", "value": "tcs_replace"},
    {"key": "baseUrl", "value": "https://api-trustme.komasi.as"},
    {"key": "buyerId", "value": "00000000-0000-0000-0000-000000000001"},
    {"key": "sellerBarcodeId", "value": "TCSELLER123"},
    {"key": "checkoutId", "value": "00000000-0000-0000-0000-000000000002"},
    {"key": "txHash", "value": "0x1111111111111111111111111111111111111111111111111111111111111111"}
  ],
  "event": [{"listen": "prerequest", "script": {"type": "text/javascript", "exec": [
    "const crypto = require('crypto-js');",
    "const timestamp = Math.floor(Date.now() / 1000).toString();",
    "const body = pm.request.body && pm.request.body.raw ? pm.request.body.raw : '';",
    "const hash = crypto.SHA256(body).toString(crypto.enc.Hex);",
    "const message = `${timestamp}\\n${pm.request.method}\\n${pm.request.url.getPathWithQuery()}\\n${hash}`;",
    "pm.request.headers.upsert({key:'X-TC-Timestamp', value:timestamp});",
    "pm.request.headers.upsert({key:'X-TC-Signature', value:crypto.HmacSHA256(message, pm.variables.get('apiSecret')).toString(crypto.enc.Hex)});",
    "pm.request.headers.upsert({key:'Authorization', value:`Bearer ${pm.variables.get('apiKey')}`});"
  ]}}],
  "item": [
    {"name":"Create buyer","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"externalRef\":\"order-123\",\"displayName\":\"Foreign buyer\"}"},"url":{"raw":"{{baseUrl}}/api/v1/buyers","host":["{{baseUrl}}"],"path":["api","v1","buyers"]}}},
    {"name":"Get buyer","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/v1/buyers/{{buyerId}}","host":["{{baseUrl}}"],"path":["api","v1","buyers","{{buyerId}}"]}}},
    {"name":"Deposit webhook","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"buyerId\":\"{{buyerId}}\",\"txHash\":\"{{txHash}}\"}"},"url":{"raw":"{{baseUrl}}/api/v1/webhooks/usdt-deposit","host":["{{baseUrl}}"],"path":["api","v1","webhooks","usdt-deposit"]}}},
    {"name":"Deposit status","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/v1/webhooks/usdt-deposit/{{txHash}}","host":["{{baseUrl}}"],"path":["api","v1","webhooks","usdt-deposit","{{txHash}}"]}}},
    {"name":"Initiate checkout","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"buyerId\":\"{{buyerId}}\",\"sellerBarcodeId\":\"{{sellerBarcodeId}}\",\"amountCoupons\":\"500\",\"externalRef\":\"order-123\",\"expiresInSeconds\":900}"},"url":{"raw":"{{baseUrl}}/api/v1/checkout/initiate","host":["{{baseUrl}}"],"path":["api","v1","checkout","initiate"]}}},
    {"name":"Capture checkout","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"checkoutId\":\"{{checkoutId}}\",\"otp\":\"0123\"}"},"url":{"raw":"{{baseUrl}}/api/v1/checkout/capture","host":["{{baseUrl}}"],"path":["api","v1","checkout","capture"]}}},
    {"name":"Cancel checkout","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"checkoutId\":\"{{checkoutId}}\"}"},"url":{"raw":"{{baseUrl}}/api/v1/checkout/cancel","host":["{{baseUrl}}"],"path":["api","v1","checkout","cancel"]}}},
    {"name":"Get checkout","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/v1/checkout/{{checkoutId}}","host":["{{baseUrl}}"],"path":["api","v1","checkout","{{checkoutId}}"]}}}
  ]
}
